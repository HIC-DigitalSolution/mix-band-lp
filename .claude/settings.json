{
  "$comment": [
    "committed = 読み取り専用のぶんだけ。書き込み・実行の権限は .claude/settings.local.json（gitignore）へ。",
    "deny は固定の床。deny > ask > allow。",
    "deny の後半は symlink 対策で、このプロジェクト固有の理由がある:",
    "harness/contracts/{workflow,secrets,lp-design}.yaml と scripts/harness/ と",
    "docs の共通ぶんは共有元（Job/LP）への symlink で、書き換えると",
    "参照している全プロジェクトに即座に効く。ここで触るものではない。"
  ],
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(sed -n *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(node scripts/harness/harness-check.mjs)",
      "Bash(node scripts/harness/harness-check.mjs *)",
      "Bash(node scripts/harness/harness-run.mjs --stage pre-commit --dry-run *)",
      "Bash(node scripts/harness/harness-run.mjs --stage pre-push --dry-run *)",
      "Bash(node scripts/harness/permission-audit.mjs *)",
      "Bash(node --test scripts/harness/lib/*.test.mjs *)"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(sed -i *)",
      "Bash(sed * -i *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Edit(scripts/harness/**)",
      "Write(scripts/harness/**)",
      "Edit(harness/README.md)",
      "Edit(harness/contracts/workflow.yaml)",
      "Edit(harness/contracts/secrets.yaml)",
      "Edit(harness/contracts/lp-design.yaml)",
      "Edit(harness/scenarios/workflow.yaml)",
      "Edit(harness/scenarios/harness-self-test.yaml)",
      "Write(harness/contracts/workflow.yaml)",
      "Write(harness/contracts/secrets.yaml)",
      "Write(harness/contracts/lp-design.yaml)",
      "Write(harness/scenarios/workflow.yaml)",
      "Write(harness/scenarios/harness-self-test.yaml)",
      "Edit(docs/README.md)",
      "Edit(docs/exec-plans/README.md)",
      "Edit(docs/exec-plans/template.md)",
      "Edit(docs/adr/_template.md)",
      "Edit(docs/gotchas/_template.md)",
      "Edit(docs/design-docs/_template.md)",
      "Edit(docs/design-docs/lp-cvr-knowledge.md)",
      "Edit(docs/design-docs/lp-visual-knowledge.md)",
      "Write(docs/design-docs/lp-cvr-knowledge.md)",
      "Write(docs/design-docs/lp-visual-knowledge.md)"
    ]
  }
}
