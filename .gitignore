# macOS
.DS_Store

# Claude Code のローカル権限。書き込み権限は共有しない（.claude/settings.json は
# 読み取り専用のぶんだけ。commit されるファイルに write 権限を入れないこと）
.claude/settings.local.json

# 一時作業。カンプの書き出し・実測スクリプト・スクリーンショット
tmp/

# 素材の原本（.ai / .psd / 未圧縮の書き出し）。重いのでリポジトリには入れない。
# 置き場は別途決める（いまは Desktop）
_src/

node_modules/
.vercel/

# **このプロジェクトのCSSの出力先は css/ だけ。**assets/css/ に style.css と
# style.css.map が出ていることがある（2026-09-09。依頼者も自分も作っていない）。
# scripts/build.mjs は .map を書かないので、出所はエディタのSassコンパイラ拡張
# （Live Sass Compiler 等）のグローバル設定。**中身は src/scss/ の古いコンパイル物で、
# 放っておくと本物の css/style.css と静かに食い違う。**
# harness の css-is-compiled-not-handwritten は css/ しか見ていないので気づけない。
# 見つけたら消す。拡張を使うなら出力先を css/ に向けるか、このリポジトリでは切る。
assets/
